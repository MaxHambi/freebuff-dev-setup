#!/bin/sh
# Local quality gate: mirrors the CI checks before every push.
# GitHub branch protection may be unavailable on private free-plan repos,
# so this hook enforces the same gate locally. Die Checks leben in EINEM
# Befehl: npm run verify (lint, tsc, syntaxcheck, tests, Doku-Gates).

echo "pre-push: running quality gate via npm run verify..."

npm run verify --silent || {
	echo "pre-push: verify failed - push aborted. Fix the issues and retry." >&2
	exit 1
}

echo "pre-push: quality gate passed."
