{
	"name": "tools-entwicklung-skills-manager",
	"version": "0.1.0",
	"private": true,
	"description": "Skills-Manager: Analyse-CLI (Scan, Klassifizierung, Delta-Index) fuer die persoenliche Agent-Skills-Bibliothek",
	"type": "module",
	"scripts": {
		"analyze": "bun run src/analyze.ts",
		"test": "bun test",
		"lint": "biome lint skills-manager --max-diagnostics=none",
		"lint:fix": "biome lint --write skills-manager --max-diagnostics=none",
		"format": "biome format --write skills-manager",
		"syntaxcheck": "pwsh -NoProfile -File scripts/syntaxcheck.ps1",
		"deploy": "pwsh -NoProfile -File scripts/deploy.ps1",
		"install-task": "pwsh -NoProfile -File scripts/install-task.ps1",
		"export-tasks": "pwsh -NoProfile -File scripts/export-tasks.ps1",
		"test:repo": "pwsh -NoProfile -File scripts/test.ps1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.6",
		"@types/bun": "latest"
	},
	"packageManager": "npm@10.9.0",
	"dependencies": {
		"@opentui/core": "^0.5.12"
	}
}
