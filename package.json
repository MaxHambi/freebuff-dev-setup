{
	"name": "tools-entwicklung",
	"version": "0.1.0",
	"private": true,
	"description": "Windows Scheduled Tasks & Watchdogs as code: deploy to %USERPROFILE%\\.tools with task XML backups",
	"scripts": {
		"lint": "biome lint . --max-diagnostics=none",
		"lint:fix": "biome lint --write . --max-diagnostics=none",
		"format": "biome format --write . --max-diagnostics=none",
		"test": "pwsh -NoProfile -File scripts/test.ps1",
		"syntaxcheck": "pwsh -NoProfile -File scripts/syntaxcheck.ps1",
		"deploy": "pwsh -NoProfile -File scripts/deploy.ps1",
		"install-task": "pwsh -NoProfile -File scripts/install-task.ps1",
		"export-tasks": "pwsh -NoProfile -File scripts/export-tasks.ps1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.6"
	},
	"packageManager": "npm@10.9.0"
}
